#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьЦенуЗаСуткиНаСервере()

    // Если объект аренды не выбран – обнулим цену и выйдем
    Если Объект.ОбъектАренды.Пустая() Тогда
        Объект.ЦенаЗаСутки = 0;
        Возврат;
    КонецЕсли;

    // Опорная дата – дата заезда, если заполнена, иначе дата документа
    ОпорнаяДата = ?(ЗначениеЗаполнено(Объект.ДатаЗаезда), Объект.ДатаЗаезда, Объект.Дата);

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |   ЦеныАренды.ЦенаЗаСутки КАК ЦенаЗаСутки
        |ИЗ
        |   РегистрСведений.ЦеныАренды КАК ЦеныАренды
        |ГДЕ
        |   ЦеныАренды.ОбъектАренды = &ОбъектАренды
        |   И ЦеныАренды.Период <= &ОпорнаяДата
        |УПОРЯДОЧИТЬ ПО
        |   ЦеныАренды.Период УБЫВ";

    Запрос.УстановитьПараметр("ОбъектАренды", Объект.ОбъектАренды);
    Запрос.УстановитьПараметр("ОпорнаяДата", ОпорнаяДата);

    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();

    Если Выборка.Следующий() Тогда
        // Нашли актуальную цену в регистре
        Объект.ЦенаЗаСутки = Выборка.ЦенаЗаСутки;
    Иначе
        // В регистре нет цен – можем взять из справочника как запасной вариант
        Объект.ЦенаЗаСутки = Объект.ОбъектАренды.ЦенаЗаСутки;
    КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ПересчитатьСуткиИСтоимость()

    Если ЗначениеЗаполнено(Объект.ДатаЗаезда)
       И ЗначениеЗаполнено(Объект.ДатаВыезда) Тогда
        
        Если Объект.ДатаВыезда <= Объект.ДатаЗаезда Тогда
            Объект.КоличествоСуток = 0;
            Объект.Стоимость = 0;
            Возврат;
        КонецЕсли;

        КоличествоСекунд = Объект.ДатаВыезда - Объект.ДатаЗаезда;
        Объект.КоличествоСуток = Цел(КоличествоСекунд / 86400);

        Если Объект.КоличествоСуток < 1 Тогда
            Объект.КоличествоСуток = 1;
        КонецЕсли;

        Если ЗначениеЗаполнено(Объект.ЦенаЗаСутки) Тогда
            Объект.Стоимость = Объект.КоличествоСуток * Объект.ЦенаЗаСутки;
        Иначе
            Объект.Стоимость = 0;
        КонецЕсли;

    Иначе
        Объект.КоличествоСуток = 0;
        Объект.Стоимость = 0;
    КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьТекущегоСотрудника()

    // Берём текущего пользователя ИБ
    ТекПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если ТекПользовательИБ = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    // По уникальному идентификатору ищем сотрудника
    Идентификатор = ТекПользовательИБ.УникальныйИдентификатор;
    Сотрудник = Справочники.Сотрудники.НайтиПоРеквизиту(
        "ИдентификаторПользователяИБ", Идентификатор);
    
    Возврат Сотрудник;

КонецФункции

#КонецОбласти


