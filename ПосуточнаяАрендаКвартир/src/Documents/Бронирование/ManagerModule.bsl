#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Процедура заполняет табличный документ для печати договора аренды.
//
// Параметры:
//   ТабДок - ТабличныйДокумент;
//   Ссылка - ДокументСсылка.Бронирование.
Процедура ДоговорАренды(ТабДок, Ссылка) Экспорт

    // Получаем объект документа по ссылке
    Док = Ссылка.ПолучитьОбъект();

    // Макет табличного документа (созданный тобой макет "ДоговорАренды")
    Макет   = ПолучитьМакет("ДоговорАренды");
    Область = Макет.ПолучитьОбласть("Основная"); // область в макете

    // Номер без лидирующих нулей
    НомерБезНулей = УдалитьЛидирующиеНули(Док.Номер);

    // Дата без времени
    ДатаБезВремени = НачалоДня(Док.Дата);
    ДатаСтрокой    = Формат(ДатаБезВремени, "ДФ=DD.MM.YYYY");

    // Сумма прописью
    ФормСтрока    = "Л=ru_RU; НП=Истина; НД=Истина; ДП=Истина";
    ПарамПредмета = "рубль,рубля,рублей,м,копейка,копейки,копеек,ж,2";
    СуммаПрописью = ЧислоПрописью(Док.Стоимость, ФормСтрока, ПарамПредмета);

    // Заполняем параметры области макета
    Область.Параметры.НомерДокумента  = НомерБезНулей;
    Область.Параметры.ДатаДокумента   = ДатаСтрокой;
    Область.Параметры.Клиент          = Док.Клиент;
    Область.Параметры.ОбъектАренды    = Док.ОбъектАренды;
    Область.Параметры.ДатаЗаезда      = Док.ДатаЗаезда;
    Область.Параметры.ДатаВыезда      = Док.ДатаВыезда;
    Область.Параметры.КоличествоСуток = Док.КоличествоСуток;
    Область.Параметры.ЦенаЗаСутки     = Док.ЦенаЗаСутки;
    Область.Параметры.Стоимость       = Док.Стоимость;
    Область.Параметры.СуммаПрописью   = СуммаПрописью;

    // Вывод в табличный документ
    ТабДок.Очистить();
    ТабДок.Вывести(Область);

КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

// Удалить ведущие нули из номера документа
Функция УдалитьЛидирующиеНули(СтрокаНомера) Экспорт

    Результат = СтрокаНомера;
    Пока СтрНачинаетсяС(Результат, "0") Цикл
        Результат = Сред(Результат, 2);
    КонецЦикла;

    Возврат Результат;

КонецФункции

#КонецОбласти

#КонецЕсли
