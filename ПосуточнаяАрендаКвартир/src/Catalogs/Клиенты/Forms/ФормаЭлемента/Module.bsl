#Область ОписаниеПеременных

&НаКлиенте
Процедура ОбновитьВидимостьПолей() Экспорт

    // Определяем, выбран ли тип "Физическое лицо"
    ЭтоФизЛицо = (Объект.ТипКлиента <> Неопределено)
        И (Строка(Объект.ТипКлиента) = "Физическое лицо"); // точное отображаемое название

    // Показываем одну группу и скрываем другую
    Элементы.ГруппаФизЛицо.Видимость = ЭтоФизЛицо;
    Элементы.ГруппаЮрЛицо.Видимость = НЕ ЭтоФизЛицо;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
    ОбновитьВидимостьПолей();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипКлиентаПриИзменении(Элемент)
    ОбновитьВидимостьПолей();
КонецПроцедуры

#КонецОбласти


